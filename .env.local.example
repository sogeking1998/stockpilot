# --- Supabase (client-safe) ---
# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only (NEVER expose to the browser) ---
# Project Settings -> API -> Project API keys -> service_role
# Used ONLY by scripts/seed.ts to create the demo user and seed data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Demo account (seeded by the script + shown on the login screen) ---
# These are intentionally public — the demo user is meant for visitors.
NEXT_PUBLIC_DEMO_EMAIL=demo@stockpilot.app
NEXT_PUBLIC_DEMO_PASSWORD=demo1234
